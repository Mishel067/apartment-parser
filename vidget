import tkinter as tk
from PIL import Image, ImageTk
import requests
from datetime import datetime
import winsound

# --- НАСТРОЙКИ ---
TARGET_DATE = datetime(2026, 8, 1, 14, 30, 0)
LAT, LON = 56.1385, 40.3998
BG_IMAGE_PATH = "background.png"

# --- ОКНО ---
root = tk.Tk()
root.title("HUD Widget")
root.overrideredirect(True)
root.attributes('-topmost', True)

# 1️⃣ ЗАГРУЗКА ФОНА
try:
    img = Image.open(BG_IMAGE_PATH)
    bg_img = ImageTk.PhotoImage(img)
    w, h = bg_img.width() // 3, bg_img.height() // 9
    root.geometry(f"{w}x{h}")
    
    bg_label = tk.Label(root, image=bg_img)
    bg_label.place(x=0, y=0, relwidth=1, relheight=1)
except Exception as e:
    print(f"⚠️ Не удалось загрузить фон: {e}")
    w, h = 400, 250
    root.geometry(f"{w}x{h}")
    bg_label = tk.Label(root, bg="black")
    bg_label.place(x=0, y=0, relwidth=1, relheight=1)

# 2️⃣ ОДИН ОБЩИЙ КОНТЕЙНЕР (вместо двух отдельных label)
container = tk.Frame(root, bg="black", padx=20, pady=10)
container.place(relx=0.5, rely=0.3, anchor="center")

# Таймер внутри контейнера
timer_lbl = tk.Label(container, text="00:00:00:00", fg="white", bg="black", 
                     font=("Consolas", 10, "bold"))
timer_lbl.pack(pady=(0, 5))  # Отступ снизу

# Погода внутри контейнера
weather_lbl = tk.Label(container, text="Загрузка...", fg="white", bg="black", 
                       font=("Consolas", 10))
weather_lbl.pack(pady=(5, 0))  # Отступ сверху

# ️ ПЕРЕТАСКИВАНИЕ
def start_drag(event): root.x, root.y = event.x, event.y
def drag_window(event):
    root.geometry(f"+{root.winfo_x() + event.x - root.x}+{root.winfo_y() + event.y - root.y}")
root.bind("<Button-1>", start_drag)
root.bind("<B1-Motion>", drag_window)

# ⏱️ ТАЙМЕР + 🔊 ТИКАНЬЕ
def update_timer():
    now = datetime.now()
    diff = TARGET_DATE - now
    
    if diff.total_seconds() <= 0:
        timer_lbl.config(text="ВРЕМЯ ВЫШЛО")
        winsound.Beep(1000, 500)
        return

    d = diff.days
    h, rem = divmod(diff.seconds, 3600)
    m, s = divmod(rem, 60)
    timer_lbl.config(text=f"{d:02d}:{h:02d}:{m:02d}:{s:02d}")
    
    winsound.Beep(800, 30)
    root.after(1000, update_timer)

# 🌤️ ПОГОДА
def get_weather():
    try:
        r = requests.get(f"https://api.open-meteo.com/v1/forecast?latitude={LAT}&longitude={LON}&current_weather=true", timeout=5)
        data = r.json()
        temp = data['current_weather']['temperature']
        wind = data['current_weather']['windspeed']
        code = data['current_weather']['weathercode']
        
        icon = "☀️" if code <= 1 else "⛅" if code <= 3 else "☁️" if code <= 48 else "🌧️" if code <= 67 else "🌨️"
        return f"{icon} {temp}°C  💨 {wind} м/с"
    except:
        return "❌ Ошибка сети"

def update_weather():
    weather_lbl.config(text=get_weather())
    root.after(600000, update_weather)

# 🚀 ЗАПУСК
update_timer()
update_weather()
root.mainloop()