#include <iostream>
#include <vector>
using namespace std;
int main(){
    int n, x;
    cin >> n;
    vector<int> a(n);
    for (int i = 0; i < n; i++){
        cin >> x;
        a[i] = x;
    }
    int maximum = a[0];
    int minimum = a[0];
    for (int i = 1; i < n; i++){
        if (a[i] > maximum){
            maximum = a[i];
        }else if (a[i] < minimum){
            minimum = a[i];
        }
    cout << minimum;
    }
    return 0;
}